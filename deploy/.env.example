# ---- Domínio ----
CHATWOOT_DOMAIN=chat.exemplo.com.br
PANEL_DOMAIN=painel.exemplo.com.br

# ---- Postgres (compartilhado: bancos "chatwoot" e "agent") ----
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=troque-me

# ---- Chatwoot ----
# Fixe a versão antes da produção (ex.: chatwoot/chatwoot:v4.x.y)
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
SECRET_KEY_BASE=gere-com-openssl-rand-hex-64
FRONTEND_URL=https://chat.exemplo.com.br
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false

# ---- Agente ----
NODE_ENV=production
LOG_LEVEL=info
ADMIN_SESSION_TTL_HOURS=12
CHATWOOT_ACCOUNT_ID=1
# Endereço do Chatwoot no navegador, para os links do painel
CHATWOOT_PUBLIC_URL=https://chat.exemplo.com.br
CHATWOOT_BOT_TOKEN=token-do-agent-bot
WEBHOOK_SECRET=valor-longo-e-aleatorio
# Assina o JWT da sessão do painel (mín. 32 caracteres); mudar derruba todo mundo logado
JWT_SECRET=outro-valor-longo-e-aleatorio
MESSAGE_DEBOUNCE_MS=4000
AGENT_MAX_STEPS=5
# Limite de mensagens por conversa
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=150
# Alertas de falha (ex.: https://ntfy.sh/<tópico-secreto>, ou webhook do Slack com formato json)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=text
# Template aprovado na Meta para o lembrete da aula experimental
REMINDER_TEMPLATE_NAME=lembrete_aula_experimental
REMINDER_TEMPLATE_LANG=pt_BR
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Preço do modelo (US$ por milhão de tokens) e cotação, para o custo no relatório
LLM_PRICE_INPUT_USD_PER_MTOK=
LLM_PRICE_OUTPUT_USD_PER_MTOK=
USD_BRL=

# ---- Backup ----
BACKUP_KEEP_DAYS=14
